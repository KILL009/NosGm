<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Legacy projects now declare the core item-trace domain, DTO, DAO and service
    files directly in their own csproj files. Only the optional GM command slices
    remain here until their large project files are normalized separately.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Frostvein.Packets'">
    <Compile Include="$(MSBuildThisFileDirectory)Data\Frostvein.Packets\Packets\CommandPackets\ItemTracePacket.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Frostvein.Handler'">
    <Compile Include="$(MSBuildThisFileDirectory)Data\Frostvein.Handler\PacketHandler\Command\ItemTraceHandler.cs" />
  </ItemGroup>
</Project>