{
  "schemaVersion": 2,
  "status": "complete",
  "service": "ClusterConfiguration",
  "authority": "gRPC",
  "fallback": null,
  "authentication": "mTLS",
  "startup": {
    "seedOwner": "Master",
    "seedBehavior": "ensure_if_unseeded",
    "preserveExistingSnapshotOnMasterRestart": true,
    "failureMode": "fail_closed"
  },
  "operations": [
    {
      "rpc": "GetConfiguration",
      "callerRoles": ["World", "Master"]
    },
    {
      "rpc": "UpdateConfiguration",
      "callerRoles": ["World", "Master"],
      "masterUse": "initial_seed_only"
    },
    {
      "rpc": "SubscribeConfigurationUpdates",
      "callerRoles": ["World"],
      "subscriberCardinality": "World_process_identity"
    },
    {
      "rpc": "GetConfigurationRuntimeInfo",
      "callerRoles": ["Master"]
    },
    {
      "rpc": "RestartConfigurationRuntime",
      "callerRoles": ["Master"]
    }
  ],
  "removedLegacySurface": [
    "IConfigurationService",
    "IConfigurationClient",
    "ConfigurationService",
    "ConfigurationClient",
    "IConfigurationRollbackTransport",
    "ScsConfigurationRollbackTransport"
  ],
  "worldFacade": {
    "type": "ConfigurationServiceClient",
    "transport": "GrpcClusterConfigurationTransport",
    "subscriber": "ConfigurationGrpcSubscriber",
    "fallback": null
  }
}
