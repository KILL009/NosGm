<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <AssemblyName>NosGM.PacketCatalog</AssemblyName>
    <RootNamespace>NosGM.PacketCatalog</RootNamespace>
    <PackageId>NosGM.PacketCatalog</PackageId>
    <Description>Deterministic NosGM packet source catalog and validation tool.</Description>
    <Authors>Blowa; SaltyEmu contributors; NosGM contributors</Authors>
    <Company>NosGM contributors</Company>
    <Copyright>Copyright remains with the respective upstream and NosGM contributors.</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/KILL009/NosGm</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>
</Project>
