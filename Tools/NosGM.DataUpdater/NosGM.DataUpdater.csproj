<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>NosGM.DataUpdater</AssemblyName>
    <RootNamespace>NosGM.DataUpdater</RootNamespace>
    <Description>External NosGM tool for extracting multilingual BCard catalogs and proposing data updates through pull requests.</Description>
    <Authors>noszanou, BCardGistUpdater contributors, NosGM contributors</Authors>
    <Copyright>Portions copyright noszanou and BCardGistUpdater contributors; modifications copyright 2026 NosGM contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <EnableNosGamePackages Condition="'$(EnableNosGamePackages)' == ''">false</EnableNosGamePackages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableNosGamePackages)' == 'true'">
    <DefineConstants>$(DefineConstants);NOSGAME_PACKAGES</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableNosGamePackages)' == 'true'">
    <PackageReference Include="Za.NosGame.Fetcher" Version="1.0.21" />
    <PackageReference Include="Za.NosGame.RessourceLoader" Version="1.0.21" />
  </ItemGroup>
</Project>
