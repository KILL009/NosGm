<Window x:Class="NosGM.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NosGM Launcher"
        Width="980"
        Height="560"
        MinWidth="880"
        MinHeight="510"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="SemiBold" Text="NosGM Launcher" />
                <TextBlock x:Name="SubtitleTextBlock"
                           Margin="0,6,0,0"
                           Foreground="DimGray"
                           Text="Actualizaciones firmadas, recuperación transaccional y lanzamiento sin privilegios administrativos." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock x:Name="LanguageLabelTextBlock" Margin="0,7,8,0" Text="Idioma:" />
                <ComboBox x:Name="LanguageComboBox"
                          Width="130"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Code"
                          SelectionChanged="Language_SelectionChanged" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,24,0,18" Padding="16" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InstallationLabelTextBlock" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Instalación:" />
                <TextBox x:Name="InstallRootTextBox" Grid.Column="1" Margin="12,0" IsReadOnly="True" />
                <Button x:Name="BrowseFolderButton" Grid.Column="2" Margin="0,0,8,0" Click="BrowseFolder_Click" Content="Examinar" />
                <Button x:Name="OpenFolderButton" Grid.Column="3" Click="OpenFolder_Click" Content="Abrir carpeta" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="StatusTextBlock"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Inicializando..." />
            <TextBlock x:Name="DetailTextBlock"
                       Margin="0,8,0,14"
                       TextWrapping="Wrap"
                       Foreground="DimGray" />
            <ProgressBar x:Name="UpdateProgressBar"
                         Height="20"
                         Minimum="0"
                         Maximum="100"
                         Value="0" />
            <TextBlock x:Name="ProgressTextBlock"
                       Margin="0,8,0,0"
                       Foreground="DimGray"
                       Text="0 %" />

            <Border Margin="0,24,0,0" Padding="14" Background="#FFF7E8" CornerRadius="5">
                <TextBlock TextWrapping="Wrap">
                    <Run x:Name="ChannelLabelRun" FontWeight="SemiBold" Text="Estado del canal: " />
                    <Run x:Name="ChannelStatusRun" Text="sin configurar" />
                </TextBlock>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ImportButton" Click="Import_Click" Content="Importar instalación" />
            <Button x:Name="CheckButton" Click="Check_Click" Content="Comprobar" />
            <Button x:Name="RepairButton" Click="Repair_Click" Content="Reparar" />
            <Button x:Name="PlayButton" Click="Play_Click" Content="Jugar" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
