<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NosGM.Launcher</AssemblyName>
    <RootNamespace>NosGM.Launcher</RootNamespace>
    <Product>NosGM Launcher</Product>
    <Company>NosGM contributors</Company>
    <Authors>NosGM contributors</Authors>
    <Description>Signed transactional updater and launcher for an authorized NosTale client installation.</Description>
    <Copyright>Copyright © 2026 NosGM contributors</Copyright>
    <RepositoryUrl>https://github.com/KILL009/NosGm</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <SteamAuthStubProjectPath>$(MSBuildThisFileDirectory)..\NosGM.SteamAuthStub\NosGM.SteamAuthStub.csproj</SteamAuthStubProjectPath>
    <SteamAuthStubPublishDirectory>$(MSBuildThisFileDirectory)..\NosGM.SteamAuthStub\bin\$(Configuration)\net10.0\win-x86\publish\</SteamAuthStubPublishDirectory>
    <SteamAuthStubDllPath>$(SteamAuthStubPublishDirectory)noscore_gf.dll</SteamAuthStubDllPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('TrustedChannel.Generated.cs')">
    <Compile Remove="TrustedChannel.Placeholder.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NosGM.Updater.Core\NosGM.Updater.Core.csproj" />
  </ItemGroup>

  <Target Name="BuildSteamAuthStubPayload"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(OS)' == 'Windows_NT'">
    <Message Importance="high" Text="Publishing NosGM Steam authentication stub (NativeAOT x86)..." />
    <Exec Command="set &quot;PATH=$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer;%25PATH%25&quot; &amp;&amp; dotnet publish &quot;$(SteamAuthStubProjectPath)&quot; -c $(Configuration) -r win-x86 --nologo -v minimal" />
    <Error Condition="!Exists('$(SteamAuthStubDllPath)')" Text="Steam authentication stub publish did not produce $(SteamAuthStubDllPath)." />
    <ItemGroup>
      <EmbeddedResource Include="$(SteamAuthStubDllPath)" LogicalName="NosGM.NosCoreGfStub" />
    </ItemGroup>
  </Target>
</Project>
