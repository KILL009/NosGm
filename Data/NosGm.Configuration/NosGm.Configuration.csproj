<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(NosGmLegacyBuild)' == 'true'">net481</TargetFramework>
    <TargetFrameworks Condition="'$(NosGmLegacyBuild)' != 'true'">net481;net10.0</TargetFrameworks>
    <RootNamespace>NosGm.Configuration</RootNamespace>
    <AssemblyName>NosGm.Configuration</AssemblyName>
    <ApplicationIcon>nosgm-emulator-icon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Reference Include="System.Runtime.Caching" />
    <PackageReference Include="System.ValueTuple" Version="4.6.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve the legacy compile surface; this local backup was never compiled. -->
    <Compile Remove="ServerConfiguration.local-backup.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="nosgm-emulator-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NosGm.Domain\NosGm.Domain.csproj" />
  </ItemGroup>

</Project>
