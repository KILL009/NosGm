<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(NosGmLegacyBuild)' == 'true'">net481</TargetFramework>
    <TargetFrameworks Condition="'$(NosGmLegacyBuild)' != 'true'">net481;net10.0</TargetFrameworks>
    <AssemblyName>NosGm.Cluster.Contracts</AssemblyName>
    <RootNamespace>NosGm.Cluster.Contracts</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Core.Api" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\contracts\cluster\v1\cluster_control.proto"
              Link="Protos\cluster_control.proto"
              ProtoRoot="..\..\contracts\cluster\v1"
              GrpcServices="Both" />
    <Protobuf Include="..\..\contracts\cluster\v1\gameforge_authentication.proto"
              Link="Protos\gameforge_authentication.proto"
              ProtoRoot="..\..\contracts\cluster\v1"
              GrpcServices="Both" />
    <Protobuf Include="..\..\contracts\cluster\v1\cluster_communication.proto"
              Link="Protos\cluster_communication.proto"
              ProtoRoot="..\..\contracts\cluster\v1"
              GrpcServices="Both" />
    <Protobuf Include="..\..\contracts\cluster\v1\cluster_communication_callbacks.proto"
              Link="Protos\cluster_communication_callbacks.proto"
              ProtoRoot="..\..\contracts\cluster\v1"
              GrpcServices="Both" />
  </ItemGroup>
</Project>
